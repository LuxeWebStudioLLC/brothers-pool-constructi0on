# Point this at any handler that accepts a JSON POST (Formspree, Basin,
# a Netlify/Vercel function, your own API). Leave unset during design review —
# submissions still succeed locally and log the payload to the console.
VITE_FORM_ENDPOINT=

# Studio enquiries from the "Built by" footer credit. Keep this DIFFERENT from
# VITE_FORM_ENDPOINT — these leads belong to the studio, not the client.
#
# Delivers to luxewebstudio112@gmail.com. A Gmail address cannot receive a JSON
# POST on its own, so point this at a form service configured to forward there:
#   Formspree  https://formspree.io/f/XXXXXXXX
#   Basin      https://usebasin.com/f/XXXXXXXX
VITE_STUDIO_FORM_ENDPOINT=
